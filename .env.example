# Modelo sem segredos. Desenvolvimento local por padrão.
# Render/AWS em produção: APP_ENV=production e ENABLE_DEV_LOGIN=false.
# Preencha os campos vazios pelo painel/gerenciador de segredos, somente no backend.
# Coleções Qdrant: ativar somente depois de criar, migrar e validar os destinos.

APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_WEB_API_KEY=
ENABLE_DEV_LOGIN=false
CORS_ALLOWED_ORIGINS=http://localhost:4173,https://astro-inter.github.io

DATABASE_URL=postgresql://usuario:senha@localhost:5432/astro
# Limite total de conexões da API por processo, incluindo tools e suporte.
POSTGRES_MAX_CONCURRENCY=2
# Limite por processo para leituras simultâneas de autorização; sem cache de perfis.
POSTGRES_AUTH_MAX_CONCURRENCY=2

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=astro

REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Segredo obrigatório no Render e no Secret/Secrets Manager da AWS.
# Os IDs de modelos são fixos no código; não é necessária chave direta de outro provedor.
OPENROUTER_API_KEY=

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=astro-ai-api
LANGSMITH_WORKSPACE_ID=
SRE_REQUESTS_PER_USER_WEEK=5
SRE_MINUTES_SAVED_PER_RESOLUTION=
SRE_HOURLY_COST_USD=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
# Bucket e Redis compartilhados com astro-api para avatares; somente backend.
# AVATAR_* prevalecem; se vazios, usam R2_ENDPOINT/R2_ACCESS_KEY_ID/
# R2_SECRET_ACCESS_KEY e REDIS_URL. Se contas/bancos diferirem, configure AVATAR_* explicitamente.
R2_BUCKET_AVATARS=
AVATAR_R2_ENDPOINT=
AVATAR_R2_ACCESS_KEY_ID=
AVATAR_R2_SECRET_ACCESS_KEY=
AVATAR_REDIS_URL=


FETCH_MCP_ALLOWED_DOMAINS=gov.br
FETCH_MCP_CACHE_TTL_SECONDS=900

A2A_PUBLIC_RESEARCH_URL=
A2A_SHARED_TOKEN=
A2A_PUBLIC_RESEARCH_TIMEOUT_SECONDS=15

# Configurações não secretas (env do Render / ConfigMap da AWS).
# Jev: seleção fechada; fallback textual permanece em Luna pelo OpenRouter.
OPENROUTER_JEV_ENABLED=true
# Checagem final inspirada na Etapa 7: habilitar após calibração (uma chamada adicional).
OPENROUTER_EVIDENCE_CHECK_ENABLED=false
QDRANT_FAQ_COLLECTION=faq_chunks_openai_te3s_v1
QDRANT_MEMORY_COLLECTION=memoria_resumos_openai_te3s_v1
# Provisório; calibrar com a base real antes do corte.
FAQ_SCORE_THRESHOLD=0.35

# URL fixa do backend Java para consultas autorizadas; usa o token do solicitante.
ASTRO_API_BASE_URL=https://api.astro-app.solutions
